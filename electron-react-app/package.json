{
  "name": "electron-react-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n ui,electron -c green,magenta \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:full": "concurrently -k -n api,ui,electron -c blue,green,magenta \"npm:dev:api\" \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:api": "dotnet run --project ../rest-server/rest-server.csproj",
    "dev:ui": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@vitejs/plugin-react": "latest",
    "axios": "^1.20.0",
    "jwt-decode": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.88.0",
    "vite": "latest",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "latest",
    "electron": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wait-on": "latest"
  }
}
