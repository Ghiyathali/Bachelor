# Azure Database for PostgreSQL Flexible Server
ConnectionStrings__Postgres="Host=<server-name>.postgres.database.azure.com;Port=5432;Database=<database-name>;Username=<admin-user>;Password=<password>;Ssl Mode=Require"

# JWT signing key: long random string (at least 32 characters). Never commit the real one.
Jwt__Key="<long-random-string>"

# Demo sign-ups and mock demographics (Development only). Keep off for shared databases.
SeedDemoData=false

# First Admin account (created automatically at startup in Development if no Admin exists)
SeedAdmin__Username="admin"
SeedAdmin__Email="admin@pangaea.test"
SeedAdmin__Password="<admin-password>"

# PYN sync (#69). Mock: the same connection string as ConnectionStrings__Postgres, and run
# rest-server/Data/PynMock/pyn_mock.sql once. At handover: PYN's read-only login and schema "analytics".
# Leave empty to switch the sync off.
ConnectionStrings__PynSource=""
PynSync__ViewSchema="pyn_mock_analytics"
